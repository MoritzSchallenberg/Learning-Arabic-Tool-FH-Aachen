# Abhängigkeiten und Build-Ausgaben — werden per npm install/npm run build neu erzeugt.
node_modules/
dist/

# Statische Website für GitHub Pages ("Website statt Installer") — wird per
# npm run build:web (scripts/buildWebSite.js) neu erzeugt und von .github/workflows/pages.yml
# in der CI gebaut/veröffentlicht, nie manuell committet (enthält u. a. eine Kopie der
# Audiodateien, würde das Repository sonst unnötig aufblähen).
docs/

# Erzeugt von "npm run package:source" (Entwicklungsauftrag 7, Abschnitt 26/27) — Release-
# Artefakt, nicht Teil des Quellcode-Repositorys.
dist-source/

# Python-Cache der Audio-Erzeugungsskripte (scripts/generate_audio*.py).
__pycache__/
scripts/__pycache__/
*.pyc

# Temporäre Dateien/Backups (u. a. von src/js/progressStore.js: *.tmp-*/*.bak-Muster,
# falls je während Tests/Entwicklung versehentlich im Repo statt im userData-Verzeichnis
# erzeugt).
*.tmp
*.tmp-*
*.bak
tmp/

# Nutzerdaten dürfen nie versioniert werden (liegen normalerweise ohnehin außerhalb des Repos
# unter app.getPath('userData'), dieser Eintrag ist eine zusätzliche Absicherung).
user_data/
*.progress.json

# Audio-Cache/-Zwischendateien, die generate_audio*.py beim Erzeugen anlegen könnte.
audio_cache/
*.audio-tmp

# Entwicklungsauftrag 12, Abschnitt 13: Staging-Bereich der Audio-Pipeline (scripts/audio/
# audioPipeline.js) -- transiente Zwischenablage vor der technischen Prüfung/Übernahme, nie
# dauerhaft, gehört nicht ins Repository.
language-packs/*/audio/.staging/

# Kurspakete (.arabiccourse-ZIPs, Meilenstein C) werden als Release-Artefakte verteilt, nicht
# im Quellcode-Repository versioniert. Allgemeine Export-/Backup-ZIPs ebenfalls ausschließen.
*.arabiccourse
*.zip

# Logs, OS-/Editor-Artefakte.
*.log
.DS_Store
Thumbs.db
.vscode/
*.swp

# Von Claude Code genutztes Arbeitsverzeichnis.
.claude/

# Entwicklungsauftrag 18, Abschnitt 7/9: Screenshots von "npm run ui:smoke" -- reine
# Diagnose-Artefakte für den lokalen Lauf, nie Teil des Repositorys oder der Quell-ZIP (ohnehin
# nicht in scripts/packageSource.js#INCLUDE gelistet, hier zusätzlich zur Klarheit für `git status`).
ui-smoke-output/
